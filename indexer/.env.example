# NFT Gacha Ponder Indexer Configuration

# RPC endpoint for the target chain
RPC_URL=http://localhost:8545

# Contract addresses (required)
GACHA_ADDRESS=0x...
TREASURY_ADDRESS=0x...

# Chain ID: 31337 (local), 80002 (Polygon Amoy), 137 (Polygon mainnet)
CHAIN_ID=31337

# Block to start indexing from (0 for genesis)
START_BLOCK=0

# Ponder port (default 42069)
PORT=42069
