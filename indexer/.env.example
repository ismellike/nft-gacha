# NFT Gacha Event Indexer Configuration

# RPC endpoint for the target chain
RPC_URL=http://localhost:8545

# Contract addresses (required)
GACHA_ADDRESS=0x...
TREASURY_ADDRESS=0x...

# Chain ID: 31337 (local), 80002 (Polygon Amoy), 137 (Polygon mainnet)
CHAIN_ID=31337

# SQLite database path
DB_PATH=./data/indexer.db

# REST API port
API_PORT=3001

# Polling interval in milliseconds
POLL_INTERVAL_MS=5000

# Number of blocks to fetch per RPC batch
BATCH_SIZE=2000
