# NFT Gacha System Environment Configuration
# Copy this file to .env and update with your values

# Deployment mode: LOCAL, TESTNET, MAINNET
DEPLOY_ENV=LOCAL

# --- Testnet Configuration (Polygon Amoy, chain ID 80002) ---
# Set DEPLOY_ENV=TESTNET and configure the vars below for testnet deployment.
# The default public RPC is used automatically; override with a paid endpoint if needed:
# TESTNET_EVM_RPC_URL_3=https://polygon-amoy.g.alchemy.com/v2/YOUR_API_KEY
#
# Existing USDC contract on Polygon Amoy (optional).
# If unset, a TestUSDC token will be deployed and minted to the deployer.
# USDC_TOKEN_ADDRESS=0x...

# --- Mainnet Configuration (Polygon, chain ID 137) ---
# Set DEPLOY_ENV=MAINNET and configure the vars below for mainnet deployment.
# The default public RPC is used automatically; override with a paid endpoint for production:
# MAINNET_EVM_RPC_URL_1=https://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY
#
# Existing USDC contract on Polygon mainnet:
# USDC_TOKEN_ADDRESS=0x3c499c542cEF5E3811e1192ce70d8cC03d5c3359

# WAVS Operator Mnemonic (IMPORTANT: Generate your own unique mnemonics!)
# These control the operator signing keys for each WAVS instance
WAVS_OPERATOR_MNEMONIC_1="test test test test test test test test test test test junk"

# WAVS Aggregator EVM Credential (for submitting transactions on-chain)
# The built-in aggregator uses this to sign and send tx to the service handler
WAVS_AGGREGATOR_EVM_CREDENTIAL="test test test test test test test test test test test junk"

# Deployer Private Key (for contract deployment and funding)
# IMPORTANT: Use a test key only - NEVER use mainnet keys
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# NFT Appraisal Service Configuration (optional)
WAVS_ENV_SCRYDEX_API_KEY=""
WAVS_ENV_SCRYDEX_TEAM_ID=""

# Rust Log Level (optional, for debugging)
RUST_LOG=info

# --- Testnet Infrastructure ---
# Contract verification (Polygonscan / Etherscan)
#ETHERSCAN_API_KEY=

# WalletConnect project ID (required for testnet/mainnet frontend)
# Get one at https://cloud.walletconnect.com
#WALLETCONNECT_PROJECT_ID=

# Override IPFS gateway for testnet (default: http://localhost:8301/ipfs/)
# Set to a public IPFS gateway when deploying to testnet
#WAVS_IPFS_GATEWAY=
