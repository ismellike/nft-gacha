{
	"$schema": "https://unpkg.com/knip@latest/schema.json",
	"entry": [
		"src/app/**/*.{ts,tsx}",
		"next.config.*",
		"tailwind.config.*",
		"postcss.config.*",
		"wagmi.config.*"
	],
	"project": ["src/**/*.{ts,tsx}", "src/**/*.css"],
	"ignoreDependencies": ["tailwind-variants", "zod", "zustand"],
	"ignore": ["src/generated.ts", "src/**/*.d.ts", "src/examples/**"]
}
