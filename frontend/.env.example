# NFT Gacha Frontend Environment Configuration
# Copy this file to .env.local and fill in the values for your environment
# DO NOT commit .env.local to version control

# ============================================================================
# CHAIN & NETWORK CONFIGURATION
# ============================================================================

# Chain ID for the network (31337 for local Anvil, 1 for Ethereum mainnet, etc.)
NEXT_PUBLIC_CHAIN_ID=31337

# RPC URL for the network
# Local Anvil: http://localhost:8548
# Testnet/Mainnet: Use your provider's RPC URL (Infura, Alchemy, etc.)
NEXT_PUBLIC_RPC_URL=http://localhost:8548

# ============================================================================
# CONTRACT ADDRESSES
# ============================================================================

# Token Contracts
NEXT_PUBLIC_USDC_ADDRESS=0x498c8d0E8ae9D3a005845C8c7F610D4B504bdd0b

# Core System Contracts
NEXT_PUBLIC_NFT_APPRAISAL_ADDRESS=0x9498E98e177a58C32fE51f54EC64eF34FADEC217
NEXT_PUBLIC_GACHA_TREASURY_ADDRESS=0x470C564Eb6c81E89140abD2752A3E57De7De9Ee1
NEXT_PUBLIC_CARD_GROUPED_VAULT_ADDRESS=0xCb3E918ef83835e79Bd4944e5f43Ec3C5c0C22DB
NEXT_PUBLIC_PROTOCOL_TREASURY_ADDRESS=0x2410806416DB9E753643EEE38f9419E1A5f17252
NEXT_PUBLIC_ECONOMY_MANAGER_ADDRESS=0x0108252275f5Cd8CB6fA0B0b69E1CB697Deb39Fc

# Gacha System Contracts
NEXT_PUBLIC_GACHA_ADDRESS=0xce59c4705b86d3E1c28a07A8bcB803A4CCf3a292
NEXT_PUBLIC_GACHA_SERVICE_HANDLER_ADDRESS=0x4967cBDEaFdD28481cD64374C482a554339874ce
NEXT_PUBLIC_APPRAISAL_SERVICE_HANDLER_ADDRESS=0xae68B92275782032732c1cb5204bce5D0F9BE839

# NFT Collection
NEXT_PUBLIC_COLLECTION_ADDRESS=0xf10008c369101a79A1ec41777108d3d01841296F

# Rarity Tracker Contracts
NEXT_PUBLIC_COMMON_TRACKER_ADDRESS=0x94f03f875115161FD51D5CcCb5aAC127833F6646
NEXT_PUBLIC_UNCOMMON_TRACKER_ADDRESS=0xd313F009b1a632be26A03c2B421bb9CACe43804F
NEXT_PUBLIC_RARE_TRACKER_ADDRESS=0x9EA17a71D0D6E21f6cDA40A55491D9fe7bAE86F1
NEXT_PUBLIC_EPIC_TRACKER_ADDRESS=0xF9f051d336c5E2A599A3592A6Bb86937bD939EaD
NEXT_PUBLIC_LEGENDARY_TRACKER_ADDRESS=0x5161FFba9f38e12bbBa92b0970c2CAF0443Cb574

# ============================================================================
# OPTIONAL CONFIGURATION
# ============================================================================

# Analytics (e.g., Google Analytics, Plausible)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Error Monitoring (e.g., Sentry DSN)
# NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Feature Flags
# NEXT_PUBLIC_ENABLE_ANALYTICS=false
# NEXT_PUBLIC_ENABLE_ERROR_TRACKING=false
# NEXT_PUBLIC_ENABLE_EXPERIMENTAL_FEATURES=false

# API Configuration (if using external APIs)
# NEXT_PUBLIC_API_URL=https://api.example.com
# NEXT_PUBLIC_API_KEY=your_api_key_here

# ============================================================================
# DEVELOPMENT NOTES
# ============================================================================
#
# 1. All NEXT_PUBLIC_ variables are exposed to the browser
#    Never put sensitive secrets in these variables
#
# 2. For local development with Anvil:
#    - Use the default values shown above
#    - Deploy contracts first using: task contracts:deploy
#    - Update addresses after deployment
#
# 3. For testnet deployment:
#    - Update NEXT_PUBLIC_CHAIN_ID to testnet chain ID
#    - Update NEXT_PUBLIC_RPC_URL to testnet RPC
#    - Deploy contracts and update all contract addresses
#
# 4. For mainnet deployment:
#    - Update NEXT_PUBLIC_CHAIN_ID to 1 (Ethereum)
#    - Update NEXT_PUBLIC_RPC_URL to mainnet RPC
#    - Deploy contracts and update all contract addresses
#    - Configure analytics and error monitoring
#
# 5. Contract addresses are auto-generated by Foundry deployments
#    Check contracts/broadcast/ after deployment for actual addresses
